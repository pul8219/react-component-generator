{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.ppk)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Read(**/*credential*)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pypirc)",
      "Read(**/.git-credentials)",
      "Read(**/*.token)",

      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*.ppk)",
      "Edit(**/id_rsa)",
      "Edit(**/id_rsa.*)",
      "Edit(**/id_dsa)",
      "Edit(**/id_ecdsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_ed25519.*)",
      "Edit(**/*credential*)",
      "Edit(**/*credentials*)",
      "Edit(**/*secret*)",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/.gnupg/**)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.git-credentials)",
      "Edit(**/*.token)",

      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pfx)",
      "Write(**/*.keystore)",
      "Write(**/*.jks)",
      "Write(**/*.ppk)",
      "Write(**/id_rsa)",
      "Write(**/id_rsa.*)",
      "Write(**/id_dsa)",
      "Write(**/id_ecdsa)",
      "Write(**/id_ed25519)",
      "Write(**/id_ed25519.*)",
      "Write(**/*credential*)",
      "Write(**/*credentials*)",
      "Write(**/*secret*)",
      "Write(**/secrets/**)",
      "Write(**/.ssh/**)",
      "Write(**/.aws/**)",
      "Write(**/.gnupg/**)",
      "Write(**/.npmrc)",
      "Write(**/.netrc)",
      "Write(**/.pypirc)",
      "Write(**/.git-credentials)",
      "Write(**/*.token)",

      "Bash(*.env*)",
      "Bash(*.pem*)",
      "Bash(*.key*)",
      "Bash(*.p12*)",
      "Bash(*.pfx*)",
      "Bash(*.keystore*)",
      "Bash(*.jks*)",
      "Bash(*.ppk*)",
      "Bash(*id_rsa*)",
      "Bash(*id_dsa*)",
      "Bash(*id_ecdsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*credential*)",
      "Bash(*credentials*)",
      "Bash(*secret*)",
      "Bash(*secrets/*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.gnupg/*)",
      "Bash(*.npmrc*)",
      "Bash(*.netrc*)",
      "Bash(*.pypirc*)",
      "Bash(*.git-credentials*)",
      "Bash(*.token*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-reminder.sh",
            "statusMessage": "TDD 규칙 확인 중..."
          }
        ]
      }
    ]
  }
}
